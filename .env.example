# Root-level variables used by the deployment configuration.
# Copy values into the Vercel/Render dashboards, not into a committed .env file.

# ---- Vercel (web + /api proxy function) ----
# Public URL of the Render API service, no trailing slash.
ROVER_API_ORIGIN=https://roverx-api.onrender.com

# Browser bundle (build-time). Leave VITE_API_BASE empty to use the /api proxy.
VITE_API_BASE=
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
VITE_MQTT_TELEMETRY_URL=
VITE_MQTT_TELEMETRY_USER=
VITE_MQTT_TELEMETRY_PASS=
VITE_MQTT_TELEMETRY_TOPIC=rover/1/telemetry
VITE_MQTT_COMMAND_URL=
VITE_MQTT_COMMAND_USER=
VITE_MQTT_COMMAND_PASS=
VITE_MQTT_COMMAND_TOPIC=rover/1/command

# ---- Render (API service) ----
# See apps/api/.env.example for the full server-side variable list.
DATABASE_URL=
ROVER_BACKEND_ENCRYPTION_KEY=
NODE_ENV=production
ROVER_BACKEND_HOST=0.0.0.0
ROVER_COOKIE_SECURE=1
ROVER_COOKIE_SAMESITE=lax
