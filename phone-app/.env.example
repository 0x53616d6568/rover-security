# Telemetry broker — dashboard subscribes only.
VITE_MQTT_TELEMETRY_URL=wss://YOUR-TELEMETRY-BROKER.s1.eu.hivemq.cloud:8884/mqtt
VITE_MQTT_TELEMETRY_USER=
VITE_MQTT_TELEMETRY_PASS=
VITE_MQTT_TELEMETRY_TOPIC=rover/1/telemetry

# Command broker — dashboard publishes only.
VITE_MQTT_COMMAND_URL=wss://YOUR-COMMAND-BROKER.s1.eu.hivemq.cloud:8884/mqtt
VITE_MQTT_COMMAND_USER=
VITE_MQTT_COMMAND_PASS=
VITE_MQTT_COMMAND_TOPIC=rover/1/command
