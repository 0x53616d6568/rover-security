# Server-side only. Never prefix these with VITE_ and never commit real values.

# Neon PostgreSQL pooled connection string (include ?sslmode=require).
DATABASE_URL=postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/rover_users?sslmode=require
# Optional. Auto-detected from ?sslmode=require above; set to 1 to force TLS.
ROVER_DATABASE_SSL=1

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ROVER_BACKEND_ENCRYPTION_KEY=

# NODE_ENV=production is required by Render; it enables Secure cookies and
# makes the API bind 0.0.0.0 unless ROVER_BACKEND_HOST is set explicitly.
NODE_ENV=production
ROVER_BACKEND_HOST=0.0.0.0
# Render injects PORT; ROVER_BACKEND_PORT is only an explicit override.
# ROVER_BACKEND_PORT=8080

# Cookie settings. With the Vercel /api proxy keep `lax`; use `none` only for a
# directly configured cross-origin frontend (and keep ROVER_COOKIE_SECURE=1).
ROVER_COOKIE_SECURE=1
ROVER_COOKIE_SAMESITE=lax
ROVER_SESSION_TTL_MS=86400000

# Comma-separated allowed origins for direct cross-origin access.
# Not needed when the Vercel /api proxy is used.
ROVER_CORS_ORIGIN=

ROVER_LOGIN_MAX_ATTEMPTS=10
