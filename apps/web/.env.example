# Vite exposes VITE_* variables to the browser bundle at BUILD TIME.
# Set these in the Vercel dashboard (or .env.local for a local build) and redeploy.

# Leave empty when the web app is served from Vercel: /api/* is proxied to the
# Render API by api/[...path].js, so the browser sees a same-origin request.
# Only set this for a direct cross-origin API (also configure CORS + SameSite=None).
VITE_API_BASE=

# Local development only: where Vite proxies /api/* when running `npm run dev`.
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# Telemetry broker — dashboard subscribes only.
VITE_MQTT_TELEMETRY_URL=wss://YOUR-TELEMETRY-BROKER.s1.eu.hivemq.cloud:8884/mqtt
VITE_MQTT_TELEMETRY_USER=
VITE_MQTT_TELEMETRY_PASS=
VITE_MQTT_TELEMETRY_TOPIC=rover/1/telemetry

# Command broker — dashboard publishes only.
VITE_MQTT_COMMAND_URL=wss://YOUR-COMMAND-BROKER.s1.eu.hivemq.cloud:8884/mqtt
VITE_MQTT_COMMAND_USER=
VITE_MQTT_COMMAND_PASS=
VITE_MQTT_COMMAND_TOPIC=rover/1/command
